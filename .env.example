# ===== super-instruct-server 部署配置示例 =====
# 复制为 .env 后按需修改。

# 出站（默认）上游：本服务改造后把请求转发到这里。
# 典型链路：client → relay(入口中转站) → 本服务(改造) → 此出站。
UPSTREAM_BASE_URL=https://api.example.com/v1

# 可选：出站 key。默认本服务「透传」入站 Authorization（即入口中转站转发时
# 在 Authorization 头里带的出站 key）。仅当入站没带 key 时才用它兜底。
UPSTREAM_API_KEY=

# 入站认证（可选）。默认不认证 = 纯改造转发。
AUTH_API_KEY=

# 本服务对外监听地址（Docker 内固定 0.0.0.0:8080）
LISTEN_ADDR=0.0.0.0:8080
